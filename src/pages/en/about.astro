---
import Layout from "../../layouts/Layout.astro";
import WhoWeAre from "../../components/sections-about-us/WhoWeAre.astro";
import HowWeWork from "../../components/sections-about-us/HowWeWork.astro";
import RecentWork from "../../components/sections-about-us/RecentWork.astro";
import FinalCTA from "../../components/FinalCTA.astro";
import Footer from "../../components/Footer.astro";
---

<Layout route="about">
  <main>
    <section id="who_we_are" class="min-h-[90dvh] bg-surface">
      <WhoWeAre />
    </section>
    <section id="recent_work" class="h-auto overflow-hidden bg-surface">
      <RecentWork />
    </section>
    <section id="how_it_works" class="min-h-[100dvh] bg-white">
      <HowWeWork />
    </section>
    <section id="final_cta" class="h-[100dvh] overflow-hidden bg-black">
      <FinalCTA variant="info" />
    </section>

    <Footer />
  </main>
</Layout>
