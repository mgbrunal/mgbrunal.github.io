---
import { ClientRouter } from "astro:transitions";
import Nav from "../components/Nav.astro";
import {
  defaultLocale,
  getLocale,
  hreflang,
  locales,
  routes,
  useTranslations,
  type RouteKey,
} from "../i18n";

interface Props {
  route: RouteKey;
  ogImage?: string;
}

const { route, ogImage = "/og.png" } = Astro.props;

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const page = t.pages[route];
const description = page.description;

// Single source of truth is `site` in astro.config.mjs
const siteUrl = Astro.site?.origin ?? "https://josue2415.com";
// Built from the route map rather than Astro.url so canonical, hreflang and the
// sitemap can never disagree about trailing slashes.
const canonical = new URL(routes[locale][route], siteUrl).href;
const ogImageAbsolute = new URL(ogImage, siteUrl).href;
const twitterImageAbsolute = new URL("/twitter.png", siteUrl).href;
const fullTitle = `${page.title} | ${t.meta.titleSuffix}`;

const alternates = locales.map((code) => ({
  hreflang: hreflang[code],
  href: new URL(routes[code][route], siteUrl).href,
}));
const xDefaultHref = new URL(routes[defaultLocale][route], siteUrl).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "JOSUE 24:15 SAS",
  alternateName: t.meta.siteName,
  url: canonical,
  logo: `${siteUrl}/og.png`,
  inLanguage: hreflang[locale],
  description: t.meta.jsonLdDescription,
  address: {
    "@type": "PostalAddress",
    addressCountry: "CO",
  },
  foundingDate: "2025",
  founders: [
    { "@type": "Person", name: t.whoWeAre.engineering.name },
    { "@type": "Person", name: t.whoWeAre.business.name },
  ],
  sameAs: [
    "https://www.linkedin.com/in/maugarbru/",
    "https://www.linkedin.com/in/lauramestraru/",
  ],
  // The Spanish site targets Colombia; the English one is for a global audience.
  areaServed:
    locale === "es"
      ? { "@type": "Country", name: "Colombia" }
      : { "@type": "Place", name: "Worldwide" },
  taxID: "902001370-7",
};
---

<!doctype html>
<html lang={hreflang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#060A06" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" type="image/png" href="/favicon.png" />

    <!-- Primary meta -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />

    <!-- Alternate locales -->
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta property="og:locale" content={t.meta.ogLocale} />
    <meta property="og:site_name" content={t.meta.siteName} />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={twitterImageAbsolute} />
    <meta name="twitter:image:alt" content={t.meta.ogImageAlt} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD structured data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <ClientRouter />
  </head>
  <body>
    <div class="min-h-screen bg-black overscroll-none">
      <Nav route={route} />
      <slot />
    </div>
  </body>
</html>

<style is:global>
  /* Scroll reveal */
  [data-reveal] {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 500ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 500ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  [data-reveal-fade] {
    opacity: 0;
    transition: opacity 600ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  [data-reveal].is-visible,
  [data-reveal-fade].is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal],
    [data-reveal-fade] {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }

    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  function initReveal() {
    const elements = document.querySelectorAll<HTMLElement>(
      "[data-reveal], [data-reveal-fade]"
    );
    if (!elements.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const delay = parseInt(el.dataset.revealDelay ?? "0", 10);
          if (delay) {
            setTimeout(() => el.classList.add("is-visible"), delay);
          } else {
            el.classList.add("is-visible");
          }
          observer.unobserve(el);
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -40px 0px" }
    );

    elements.forEach((el) => observer.observe(el));
  }

  document.addEventListener("astro:page-load", initReveal);
</script>
