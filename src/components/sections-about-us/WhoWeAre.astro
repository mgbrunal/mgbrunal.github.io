---
import { Image } from "astro:assets";
import mauroPhoto from "../../assets/img/mauro.png";
import lauraPhoto from "../../assets/img/laura.jpeg";

import { useTranslations } from "../../i18n";

const t = useTranslations(Astro.currentLocale);
const engineering = t.whoWeAre.engineering;
const business = t.whoWeAre.business;

const currentYear = new Date().getFullYear();
const mauroYears = currentYear - 2019;
const lauraYears = currentYear - 2021;
---

<div class="w-full h-full flex flex-col items-center justify-center py-20">
  <div class="w-full h-full xl:max-w-[75%] px-5 sm:px-20">
    <div class="w-full h-full flex flex-col items-start justify-center gap-8">
      <div
        class="w-full flex flex-col items-center justify-center gap-4 text-center"
      >
        <p
          data-reveal
          class="text-sm sm:text-base font-light text-white uppercase"
        >
          {t.whoWeAre.eyebrow}
        </p>

        <div data-reveal data-reveal-delay="80" class="w-full bg-white px-5 py-4">
          <h2 class="text-3xl sm:text-5xl font-bold text-black drop-shadow">
            {t.whoWeAre.title}
          </h2>
        </div>

        <p data-reveal data-reveal-delay="160" class="text-sm sm:text-lg font-semibold text-white drop-shadow">
          {t.whoWeAre.lead}
        </p>
      </div>

      <div
        class="w-full flex flex-col lg:flex-row items-start justify-start gap-4"
      >
        <!-- ENGINEERING CARD -->
        <div data-reveal data-reveal-delay="80" class="w-full lg:w-1/2 flex flex-col bg-black border border-secondary/20 shadow-lg">
          <!-- Role info -->
          <div class="flex flex-col items-start justify-between gap-4 px-5 py-4 border-b border-secondary/20">
            <div class="w-full py-2">
              <h3 class="text-lg sm:text-xl font-bold text-secondary uppercase">{engineering.role}</h3>
              <h4 class="text-sm sm:text-base font-light text-secondary uppercase">{engineering.subrole}</h4>
            </div>
            <p class="text-sm sm:text-base text-white">
              {engineering.description}
            </p>
            <div class="flex flex-col items-start gap-3 w-full">
              {
                engineering.badges.map((badge) => (
                  <p class="text-xs sm:text-sm text-white font-light p-2 bg-primary/50 rounded-full">
                    {badge}
                  </p>
                ))
              }
            </div>
          </div>
          <!-- Person info -->
          <div class="flex flex-col items-start gap-4 px-5 py-4">
            <div class="flex flex-row items-center gap-4 w-full">
              <Image
                src={mauroPhoto}
                alt={engineering.name}
                class="w-14 h-14 object-cover shrink-0 ring-2 ring-secondary/50"
                width={56}
                height={56}
                loading="eager"
              />
              <div>
                <p class="text-base sm:text-lg font-bold text-white leading-tight">{engineering.name}</p>
                <p class="text-xs font-light text-secondary uppercase tracking-wide">{engineering.title}</p>
              </div>
            </div>
            <div class="flex flex-row items-baseline gap-2 border-l-2 border-secondary pl-3">
              <span class="text-3xl font-bold text-secondary leading-none">+{mauroYears}</span>
              <div class="flex flex-col">
                <span class="text-xs text-white font-semibold leading-tight">{t.whoWeAre.yearsLabel}</span>
                <span class="text-xs text-white/50 font-light">{engineering.education}</span>
              </div>
            </div>
            <p class="text-sm font-light text-white/80 leading-relaxed">
              {engineering.bio}
            </p>
            <div class="flex flex-row flex-wrap gap-2">
              {
                engineering.skills.map((skill) => (
                  <span class="text-xs text-white/60 px-2 py-1 bg-secondary/10 rounded-full">
                    {skill}
                  </span>
                ))
              }
            </div>
            <a href="https://www.linkedin.com/in/maugarbru/" target="_blank" rel="noopener noreferrer"
              class="flex flex-row items-center gap-2 text-xs text-secondary font-light can-hover:hover:text-white transition-colors duration-200 no-underline">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 118.3 6.5a1.78 1.78 0 01-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0013 14.19a.66.66 0 000 .14V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.4c1.55 0 3.36.86 3.36 3.66z"/></svg>
              linkedin.com/in/maugarbru
            </a>
          </div>
        </div>

        <!-- BUSINESS CARD -->
        <div data-reveal data-reveal-delay="180" class="w-full lg:w-1/2 flex flex-col bg-black border border-tertiary/20 shadow-lg">
          <!-- Role info -->
          <div class="flex flex-col items-start justify-between gap-4 px-5 py-4 border-b border-tertiary/20">
            <div class="w-full py-2">
              <h3 class="text-lg sm:text-xl font-bold text-tertiary uppercase">{business.role}</h3>
              <h4 class="text-sm sm:text-base font-light text-tertiary uppercase">{business.subrole}</h4>
            </div>
            <p class="text-sm sm:text-base text-white">
              {business.description}
            </p>
            <div class="flex flex-col items-start gap-3 w-full">
              {
                business.badges.map((badge) => (
                  <p class="text-xs sm:text-sm text-white font-light p-2 bg-primary/50 rounded-full">
                    {badge}
                  </p>
                ))
              }
            </div>
          </div>
          <!-- Person info -->
          <div class="flex flex-col items-start gap-4 px-5 py-4">
            <div class="flex flex-row items-center gap-4 w-full">
              <Image
                src={lauraPhoto}
                alt={business.name}
                class="w-14 h-14 object-cover shrink-0 ring-2 ring-tertiary/50"
                width={56}
                height={56}
                loading="eager"
              />
              <div>
                <p class="text-base sm:text-lg font-bold text-white leading-tight">{business.name}</p>
                <p class="text-xs font-light text-tertiary uppercase tracking-wide">{business.title}</p>
              </div>
            </div>
            <div class="flex flex-row items-baseline gap-2 border-l-2 border-tertiary pl-3">
              <span class="text-3xl font-bold text-tertiary leading-none">+{lauraYears}</span>
              <div class="flex flex-col">
                <span class="text-xs text-white font-semibold leading-tight">{t.whoWeAre.yearsLabel}</span>
                <span class="text-xs text-white/50 font-light">{business.education}</span>
              </div>
            </div>
            <p class="text-sm font-light text-white/80 leading-relaxed">
              {business.bio}
            </p>
            <div class="flex flex-row flex-wrap gap-2">
              {
                business.skills.map((skill) => (
                  <span class="text-xs text-white/60 px-2 py-1 bg-tertiary/10 rounded-full">
                    {skill}
                  </span>
                ))
              }
            </div>
            <a href="https://www.linkedin.com/in/lauramestraru/" target="_blank" rel="noopener noreferrer"
              class="flex flex-row items-center gap-2 text-xs text-tertiary font-light can-hover:hover:text-white transition-colors duration-200 no-underline">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 118.3 6.5a1.78 1.78 0 01-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0013 14.19a.66.66 0 000 .14V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.4c1.55 0 3.36.86 3.36 3.66z"/></svg>
              linkedin.com/in/lauramestraru
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
